# Optional: guest multiplayer also works without Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://nwdjucplpyorwiwshxtf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Game server URL (use your machine's LAN address when testing on a phone).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# Enable only after configuring the Google provider in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Separately deployed administration app.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100
# production only on the live Vercel target; staging/development never send analytics.
NEXT_PUBLIC_APP_ENV=development
# Vercel supplies NEXT_PUBLIC_VERCEL_ENV when system environment variables are exposed.
